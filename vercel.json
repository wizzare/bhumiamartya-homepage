{
  "functions": {
    "api/blueprint.mjs": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/reading.mjs": {
      "maxDuration": 10,
      "memory": 256
    }
  },
  "redirects": [
    {
      "source": "/reading",
      "destination": "/tes-kenali-diri/",
      "permanent": true
    },
    {
      "source": "/reading/",
      "destination": "/tes-kenali-diri/",
      "permanent": true
    },
    {
      "source": "/produk/blueprint-reading",
      "destination": "/tes-kenali-diri/",
      "permanent": true
    },
    {
      "source": "/produk/blueprint-reading/",
      "destination": "/tes-kenali-diri/",
      "permanent": true
    },
    {
      "source": "/ebook",
      "destination": "/ebooks/",
      "permanent": true
    },
    {
      "source": "/ebook/",
      "destination": "/ebooks/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/_next/:path*",
      "destination": "https://bhumi-amartya-clean.vercel.app/_next/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://bhumi-amartya-clean.vercel.app/images/:path*"
    },
    {
      "source": "/articles/:slug",
      "destination": "/articles/detail.html"
    },
    {
      "source": "/articles/:slug/",
      "destination": "/articles/detail.html"
    },
    {
      "source": "/ebooks/:slug",
      "destination": "/ebooks/detail.html"
    },
    {
      "source": "/ebooks/:slug/",
      "destination": "/ebooks/detail.html"
    },
    {
      "source": "/founder",
      "destination": "https://bhumi-amartya-clean.vercel.app/founder"
    },
    {
      "source": "/founder/:path*",
      "destination": "https://bhumi-amartya-clean.vercel.app/founder/:path*"
    },
    {
      "source": "/api/wedhaswara-articles",
      "destination": "https://wedhaswara.my.id/wp-json/wp/v2/posts?per_page=6&_embed=1"
    }
  ]
}
